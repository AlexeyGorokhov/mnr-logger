{
  "name": "mnr-logger",
  "version": "3.0.1",
  "description": "Opinionated logger for Node.js",
  "type": "module",
  "exports": "./dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "eslint ./ && npm run tsc && vitest run",
    "tsc": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig-build.json && api-extractor run --local --verbose"
  },
  "author": {
    "name": "Alexey Gorokhov",
