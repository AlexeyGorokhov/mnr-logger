  },
  "license": "MIT",
  "keywords": [
    "logger"
  ],
  "homepage": "https://github.com/AlexeyGorokhov/mnr-logger",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexeyGorokhov/mnr-logger"
  },
  "bugs": {
    "url": "https://github.com/AlexeyGorokhov/mnr-logger/issues"
  },
  "devDependencies": {
    "@memnrev/eslint-v9-config": "^0.4.0",
    "@microsoft/api-extractor": "^7.48.0",
    "@peassoft/verror": "^1.0.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^24.10.4",
    "eslint": "^9.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.16"
  }
